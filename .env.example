# Copy to `.env` for local development. In production set these in the Vercel
# project settings (Settings → Environment Variables).

# --- Database -------------------------------------------------------------
# Any Postgres connection string. Works with Prisma Postgres, Neon, Supabase, etc.
# For local development, run `npx prisma dev --name mahingan` and paste the
# direct TCP URL it prints here.
DATABASE_URL="postgres://user:password@localhost:5432/mahingan"

# --- Owner area (/admin) --------------------------------------------------
# Password used to sign in at /admin/login.
ADMIN_PASSWORD="change-me"
# Secret used to sign the admin session cookie. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this immediately signs out every existing session.
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# --- Email (Resend) -------------------------------------------------------
# Shared with the existing contact form. Without RESEND_API_KEY the app still
# records signups; it just skips sending mail and logs that it did so.
RESEND_API_KEY=""
# Must be an address on a domain you have verified in Resend.
RESEND_FROM="Mahingan Martial Arts <noreply@mahinganma.com>"
# Where contact-form messages go.
CONTACT_TO_EMAIL=""
# Where new-signup notifications go. Falls back to CONTACT_TO_EMAIL, then to
# the address in lib/site.ts.
SIGNUP_NOTIFY_EMAIL=""
