# Public marketing site — Smartwaiver template for signup CTAs.
# Find the template ID in Smartwaiver → Waiver → Share / API.
NEXT_PUBLIC_SMARTWAIVER_TEMPLATE_ID=
# Optional per-program waiver URLs (used instead of the shared template).
NEXT_PUBLIC_SMARTWAIVER_WAIVER_BJJ=
NEXT_PUBLIC_SMARTWAIVER_WAIVER_BOXING=
NEXT_PUBLIC_SMARTWAIVER_WAIVER_YOUNG_WARRIORS=
NEXT_PUBLIC_SMARTWAIVER_WAIVER_TRIAL=

# Lakebase Postgres (pooled for the app, unpooled for Drizzle migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Comma-separated emails allowed to use /admin (sign-in only; no public sign-up)
ADMIN_EMAILS=info@mahinganma.com

# Smartwaiver API (server). Webhook path is /api/webhooks/smartwaiver/<token>
SMARTWAIVER_API_KEY=
SMARTWAIVER_WEBHOOK_TOKEN=

# Optional: custom waiver field display-text matchers for extra consent checkboxes
SMARTWAIVER_CONSENT_EMAIL_FIELD=
SMARTWAIVER_CONSENT_SMS_FIELD=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BJJ=
STRIPE_PRICE_BOXING=
STRIPE_PRICE_YOUNG_WARRIORS=
STRIPE_PRICE_TRIAL=

# Resend (contact form + admin email). RESEND_FROM must be a verified domain sender.
RESEND_API_KEY=
RESEND_FROM=
CONTACT_TO_EMAIL=info@mahinganma.com
RESEND_AUDIENCE_ID=
RESEND_SEGMENT_ID=
RESEND_WEBHOOK_SECRET=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_INBOUND_AUTH_TOKEN=

# Protects /api/cron/* (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
