# Copy to `.env` for local development. In production set these in the Vercel
# project settings (Settings → Environment Variables), scoped to Preview and
# Production. After changing env vars, redeploy for them to take effect.

# --- Database (Neon) ------------------------------------------------------
# Pooled connection string — used at runtime by the app.
# Neon console → your project → Connection string → "Pooled connection".
# Example:
#   postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection — used by Prisma migrations.
# Neon console → Connection string → toggle off "Pooled connection".
# If you installed Neon via the Vercel Marketplace this is often injected as
# DATABASE_URL_UNPOOLED or POSTGRES_URL_NON_POOLING automatically.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Owner area (/admin) --------------------------------------------------
# Password used to sign in at /admin/login.
ADMIN_PASSWORD="change-me"
# Secret used to sign the admin session cookie. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this immediately signs out every existing session.
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# --- Email (Resend) -------------------------------------------------------
# Shared with the existing contact form. Without RESEND_API_KEY the app still
# records signups; it just skips sending mail and logs that it did so.
RESEND_API_KEY=""
# Must be an address on a domain you have verified in Resend.
RESEND_FROM="Mahingan Martial Arts <noreply@mahinganma.com>"
# Where contact-form messages go.
CONTACT_TO_EMAIL=""
# Where new-signup notifications go. Falls back to CONTACT_TO_EMAIL, then to
# the address in lib/site.ts.
SIGNUP_NOTIFY_EMAIL=""
